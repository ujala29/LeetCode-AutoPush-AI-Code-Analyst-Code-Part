{
  "permissions": {
    "allow": [
      "PowerShell($repo = \"$env:TEMP\\\\lc-reset\"; if \\(Test-Path $repo\\) { Remove-Item $repo -Recurse -Force }; git clone https://github.com/ujala29/Leetcode_Code_Push_Automation.git $repo)",
      "PowerShell($repo = \"$env:TEMP\\\\lc-reset\"; git -C $repo checkout --orphan fresh-start)",
      "PowerShell($repo = \"$env:TEMP\\\\lc-reset\"; git -C $repo rm -rf .)",
      "PowerShell($repo = \"$env:TEMP\\\\lc-reset\"; git -C $repo push origin fresh-start:main --force)"
    ]
  }
}
